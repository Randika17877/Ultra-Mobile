<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/um_background"
    tools:context=".fragment.ProductDetailsFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/product_details_bottom_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Image slider -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@color/um_surface_card">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/product_image_slider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                    android:id="@+id/dotsIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    app:dotsColor="@color/um_surface_elevated"
                    app:selectedDotColor="@color/um_primary"
                    app:dotsSize="7dp"
                    app:dotsSpacing="4dp" />

                <ImageButton
                    android:id="@+id/product_details_wishlist_btn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|top"
                    android:layout_margin="16dp"
                    android:background="@drawable/um_bg_circle"
                    android:elevation="4dp"
                    android:padding="10dp"
                    android:src="@drawable/favorite_24px"
                    app:tint="@color/um_text_secondary" />

            </FrameLayout>

            <!-- Product title & price -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@color/um_surface_card">

                <TextView
                    android:id="@+id/product_details_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Product Name"
                    android:textColor="@color/um_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <RatingBar
                    android:id="@+id/product_details_rating"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:progressTint="@color/um_primary"
                    android:rating="4.5" />

                <TextView
                    android:id="@+id/product_details_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="LKR 0.00"
                    android:textColor="@color/um_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/um_surface_border" />

            <!-- Attributes & Quantity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@color/um_background">

                <LinearLayout
                    android:id="@+id/product_details_attribute_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="QUANTITY"
                    android:textColor="@color/um_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/product_details_btn_minus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="–"
                        android:textSize="18sp"
                        android:textColor="@color/um_primary"
                        android:background="@drawable/um_btn_secondary"
                        android:padding="0dp" />

                    <TextView
                        android:id="@+id/product_details_quantity"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textAlignment="center"
                        android:textColor="@color/um_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/product_details_btn_plus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textSize="18sp"
                        android:textColor="@color/um_primary"
                        android:background="@drawable/um_btn_secondary"
                        android:padding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Available:"
                        android:textColor="@color/um_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/product_details_avb_qty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/um_success"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/um_surface_border" />

            <!-- Related products section -->
            <include
                android:id="@+id/product_details_top_sell_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/item_section" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom CTA bar -->
    <LinearLayout
        android:id="@+id/product_details_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@color/um_surface"
        android:padding="12dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/product_details_btn_add_cart"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/um_btn_secondary"
            android:foreground="?attr/selectableItemBackground"
            android:text="Add to Cart"
            android:textColor="@color/um_primary"
            android:textStyle="bold"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/product_details_btn_buy_now"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/um_btn_primary"
            android:foreground="?attr/selectableItemBackground"
            android:text="Buy Now"
            android:textColor="@color/um_text_on_primary"
            android:textStyle="bold"
            android:textSize="14sp" />

    </LinearLayout>

</RelativeLayout>
