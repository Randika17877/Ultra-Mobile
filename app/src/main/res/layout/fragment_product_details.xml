<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/um_background"
    tools:context=".fragment.ProductDetailsFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/product_details_bottom_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Premium Image slider with rounded bottom -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="420dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.BottomRounded">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/um_surface_card">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/product_image_slider"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                        android:id="@+id/dotsIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="20dp"
                        app:dotsColor="@color/um_text_hint"
                        app:selectedDotColor="@color/um_primary"
                        app:dotsSize="8dp"
                        app:dotsSpacing="4dp" />

                    <ImageButton
                        android:id="@+id/product_details_wishlist_btn"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|top"
                        android:layout_margin="16dp"
                        android:background="@drawable/um_bg_circle"
                        android:elevation="6dp"
                        android:padding="12dp"
                        android:src="@drawable/favorite_24px"
                        app:tint="@color/um_text_secondary" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Product Info Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/product_details_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Product Name"
                    android:textColor="@color/um_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RatingBar
                        android:id="@+id/product_details_rating"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:progressTint="@color/um_warning"
                        android:rating="4.5" />

                    <TextView
                        android:id="@+id/product_details_rating_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="(4.5)"
                        android:textColor="@color/um_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/product_details_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="LKR 0.00"
                    android:textColor="@color/um_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Description Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textColor="@color/um_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/product_details_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Discover high-performance technology with an elegant design. This device offers everything you need for a modern lifestyle."
                    android:textColor="@color/um_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="20dp"
                android:background="@color/um_surface_border" />

            <!-- Dynamic Attributes Container -->
            <LinearLayout
                android:id="@+id/product_details_attribute_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp" />

            <!-- Quantity Selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUANTITY"
                    android:textColor="@color/um_text_secondary"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/um_surface_outline_rounded"
                        android:padding="4dp"
                        android:gravity="center_vertical">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/product_details_btn_minus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="–"
                            android:textSize="20sp"
                            android:textColor="@color/um_primary"
                            android:background="@drawable/um_btn_icon_only"
                            android:padding="0dp" />

                        <TextView
                            android:id="@+id/product_details_quantity"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textAlignment="center"
                            android:textColor="@color/um_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/product_details_btn_plus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="+"
                            android:textSize="20sp"
                            android:textColor="@color/um_primary"
                            android:background="@drawable/um_btn_icon_only"
                            android:padding="0dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/product_details_avb_qty_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="Only "
                        android:textColor="@color/um_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/product_details_avb_qty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/um_success"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" left"
                        android:textColor="@color/um_text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="20dp"
                android:background="@color/um_surface_border" />

            <!-- Related products section -->
            <include
                android:id="@+id/product_details_top_sell_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                layout="@layout/item_section" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Elevated Bottom Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/product_details_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardElevation="12dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/um_surface"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/product_details_btn_add_cart"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/um_btn_secondary"
                android:text="Add to Cart"
                android:textAllCaps="false"
                android:textColor="@color/um_primary"
                android:textStyle="bold"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/product_details_btn_buy_now"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.2"
                android:background="@drawable/um_btn_primary"
                android:text="Buy Now"
                android:textAllCaps="false"
                android:textColor="@color/um_text_on_primary"
                android:textStyle="bold"
                android:textSize="16sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
