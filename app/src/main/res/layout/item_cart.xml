<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/um_surface_card"
    app:strokeColor="@color/um_surface_border"
    app:strokeWidth="1dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Product image -->
        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@color/um_surface_elevated">

            <ImageView
                android:id="@+id/item_cart_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="8dp" />

        </FrameLayout>

        <!-- Product info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/item_cart_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Title"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/um_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/item_cart_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="LKR 1,500.00"
                android:textColor="@color/um_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/item_cart_remove"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/delete_24px"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Qty controls -->
        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/item_cart_btn_plus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="18sp"
                android:textColor="@color/um_primary"
                android:background="@drawable/um_btn_secondary"
                android:padding="0dp" />

            <TextView
                android:id="@+id/item_cart_quantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="1"
                android:textAlignment="center"
                android:textColor="@color/um_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/item_cart_btn_minus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="–"
                android:textSize="18sp"
                android:textColor="@color/um_primary"
                android:background="@drawable/um_btn_secondary"
                android:padding="0dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
